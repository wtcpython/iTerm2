          }
        }
      }
    },
    "Looks like resize reporting was left on when an ssh session ended unexpectedly or an app misbehaved. Turn it off?": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看起来 ssh 会话意外结束或应用异常时，调整大小上报仍处于开启状态。要关闭吗？"
          }
        }
      }
    },
    "Looks like mouse reporting was left on when an ssh session ended unexpectedly or an app misbehaved. Turn it off?": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
