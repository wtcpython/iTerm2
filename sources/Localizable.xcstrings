    },
    "This arrangement’s profile is missing. This could be due to a bug in iTerm2 version 3.5.7, which caused profiles to be corrupted in saved arrangements.": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口布局对应的配置文件缺失。这可能是 iTerm2 3.5.7 版的一个 bug 所致，该版本会导致已保存布局中的配置文件损坏。"
          }
        }
      }
    },
    "**Properties to be changed:**\n\n%@": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**将更改的属性：**\n\n%@"
          }
        }
      }
    },
    "An app tried to change [multiple profile properties](%@).": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个应用尝试更改[多个配置文件属性](%@)。"
          }
        }
      }
    },
    "Would you like macOS Text Replacements to be applied automatically?": {
      "sourceLanguage": "en",
