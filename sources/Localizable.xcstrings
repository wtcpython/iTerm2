          "stringUnit": {
            "state": "translated",
            "value": "密钥安全存储在 macOS 钥匙串中。"
          }
        }
      }
    },
    "Add Custom Header": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自定标头"
          }
        }
      }
    },
    "Enter a header name and value. The name is required.": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入标头名称和值。名称为必填项。"
          }
        }
      }
    },
    "The header name must be non-empty and contain only RFC 7230 token characters (letters, digits, and any of !#$%&'*+-.^_`|~).": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标头名称不能为空，且只能包含 RFC 7230 令牌字符（字母、数字以及 !#$%&'*+-.^_`|~ 中的字符）。"
          }
        }
      }
    },
    "The header value must not contain newline or null characters.": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标头值不能包含换行符或空字符。"
          }
        }
      }
    },
    "Invalid HTTP header": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
