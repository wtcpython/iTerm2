      }
    },
    "The header name must be non-empty and contain only RFC 7230 token characters (letters, digits, and any of !#$%&'*+-.^_`|~).": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
