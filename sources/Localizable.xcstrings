    "It is taking a long time to locate all scripts under %@. Avoid storing many files or using network mounts for the scripts folder.\\n\\nContinue?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位 %@ 下的所有脚本耗时较长。避免在脚本文件夹中存储大量文件或使用网络挂载。\\n\\n继续？"
