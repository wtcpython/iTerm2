            "value": "iTerm2 需要更新"
          }
        }
      }
    },
    "iTerm2 can display files like this in its built-in web browser! Would you like to open this link in iTerm2?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 可以在其内置网页浏览器中显示此类文件！要在 iTerm2 中打开此链接吗？"
          }
        }
      }
    },
    "iTerm2 can display web pages! But first you must download the Browser Plugin.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 可以显示网页！但首先你必须下载浏览器插件。"
          }
        }
      }
    },
    "iTerm2 can display web pages! Would you like to open this link in iTerm2?": {
      "localizations": {
