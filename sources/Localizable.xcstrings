    "A browser session failed to start because the iTerm2 Browser Plugin couldn’t be found.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器会话启动失败，因为找不到 iTerm2 浏览器插件。"
          }
        }
      }
    },
    "A companion device is paired and connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对并连接 Companion 设备。"
          }
        }
      }
    },
    "A companion device is paired but iTerm2 isn’t listening for it yet. Reconnecting…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Companion 设备已配对，但 iTerm2 尚未开始监听。正在重新连接…"
