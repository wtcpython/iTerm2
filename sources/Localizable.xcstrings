    "Erase Command History": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抹掉命令历史记录"
          }
        }
      }
    },
    "Command history for all hosts will be erased. Continue?": {
      "sourceLanguage": "en",
      "localizations": {
