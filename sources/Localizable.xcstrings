    "iTerm2 cannot watch the job %@ with process ID %@ because it has already terminated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 无法监视进程 ID 为 %2$@ 的任务 %1$@，因为它已经终止。"
          }
        }
      }
    },
    "How would you like to paste %@?": {
