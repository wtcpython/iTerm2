    "Copy local settings to custom folder now?": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即将本地设置拷贝到自定义文件夹？"
          }
