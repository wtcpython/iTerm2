    "The application attempted to set the badge to a value that would invoke a function call. For security reasons, this is not allowed and the badge was not updated.": {
      "sourceLanguage": "en",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
