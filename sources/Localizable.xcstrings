    },
    "Save selection to arrangement %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将选择存储到窗口布局 %@"
          }
        }
      }
    },
    "Save selection to profile %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将选择存储到配置文件 %@"
          }
        }
      }
    },
    "iTerm2 cannot watch the job %@ with process ID %@ because it has already terminated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iTerm2 无法监视进程 ID 为 %2$@ 的任务 %1$@，因为它已经终止。"
          }
        }
      }
    },
    "How would you like to paste %@?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想如何粘贴 %@？"
          }
        }
      }
    },
    "The clipboard contains %@ image data (%@). How would you like to paste it?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板包含 %@ 图像数据（%@）。你想如何粘贴它？"
          }
        }
      }
    },
    "OK to paste %@ bytes of base64-encoded data?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 %@ 字节的 Base64 编码数据？"
          }
        }
      }
    },
    "%@ Continue removing the workgroup and triggers anyway? cc-status will keep running until you fix the underlying issue and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 继续移除 workgroup 和触发器？cc-status 将继续运行，直到你修复根本问题并重试。"
          }
        }
      }
    },
    "Could not write to %@: %@": {
